# Same repository published by GitHub Actions; include :latest.
SCRAPER_IMAGE=YOUR_DOCKERHUB_USERNAME/job-scraper:latest
# Generate a key: openssl rand -hex 32
API_KEY=
MAX_REQ_PER_MIN=120
# Set your own external services; /job_scraper selects the MongoDB database.
MONGODB_URL=mongodb://USER:PASSWORD@HOST:27017/job_scraper?authSource=admin
REDIS_URL=redis://:PASSWORD@HOST:6379/0
